# Local Airflow development only. Copy this file to .env and replace values.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.0
FERNET_KEY=replace_with_a_generated_fernet_key
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_a_long_random_secret
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=replace_with_a_local_password

# Databricks credentials are configured through the Airflow connection
# named `databricks_default`; never commit its token or OAuth secret.
